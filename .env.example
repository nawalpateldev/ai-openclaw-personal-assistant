# ==============================================================================
# OpenClaw Environment Configuration
# ==============================================================================

# Server & Dashboard Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Web Dashboard Security
# Master password used to log in to the OpenClaw Dashboard
DASHBOARD_PASSWORD=ChangeThisSecurePassword123!
# Secret key used for signing JWT authentication tokens
JWT_SECRET=openclaw_super_secure_jwt_secret_key_random_string_987654321
# Security policies: Max failed attempts before IP lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Captcha difficulty: 'easy', 'medium', 'hard' (uses self-hosted SVG captcha)
CAPTCHA_DIFFICULTY=medium

# ------------------------------------------------------------------------------
# LLM Providers & Resilient Gateway (Primary -> Fallback Chain)
# ------------------------------------------------------------------------------

# Primary: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fallback 1: OpenAI (Activated if Gemini reaches rate-limit or errors)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Fallback 2: Anthropic Claude (Activated if OpenAI is unavailable)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Fallback 3: Local Offline Ollama (Zero cloud dependency)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# Dynamic Multi-Account Email Configuration (Supports 10+ Accounts)
# ------------------------------------------------------------------------------
# Accounts can be managed dynamically via:
# 1. config/email-accounts.json (Template provided below)
# 2. OpenClaw Web Dashboard UI (Add, Edit, Test, Enable/Disable dynamically)
# 3. Optional inline JSON environment variable
EMAIL_ACCOUNTS_FILE=./config/email-accounts.json
# Optional default account ID for when none is explicitly specified
DEFAULT_EMAIL_ACCOUNT_ID=personal

# ------------------------------------------------------------------------------
# Messaging Channels
# ------------------------------------------------------------------------------

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
# Comma-separated list of authorized Telegram User IDs (pairing whitelist)
TELEGRAM_ALLOWED_USER_IDS=

# WhatsApp Integration (via Cloud API or Webhook Bridge)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ALLOWED_NUMBERS=
